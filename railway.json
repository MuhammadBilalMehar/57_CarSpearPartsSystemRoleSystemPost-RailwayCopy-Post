{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "cd tailproject && python manage.py collectstatic --noinput"
  },
  "deploy": {
    "preDeployCommand": [
      "cd tailproject && python manage.py migrate --noinput"
    ],
    "startCommand": "cd tailproject && gunicorn tailproject.wsgi:application --bind 0.0.0.0:$PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
